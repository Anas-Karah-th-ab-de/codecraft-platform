[Unit]
Description=KM Code Craft API
After=network-online.target postgresql.service

[Service]
User=codecraft
EnvironmentFile=/etc/codecraft/server.env
ExecStart=/opt/codecraft/codecraft-server
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# /var/lib/codecraft beschreibbar (POS_BACKUP_DIR=/var/lib/codecraft/pos-backups)
StateDirectory=codecraft

[Install]
WantedBy=multi-user.target
