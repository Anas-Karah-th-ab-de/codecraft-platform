{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KM Portal",
  "version": "0.1.0",
  "identifier": "tech.codecraft.portal",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "KM Code Craft Portal",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 380,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "category": "Business",
    "publisher": "KM Code Craft",
    "copyright": "© KM Code Craft",
    "shortDescription": "Portal für Team und Kunden",
    "longDescription": "Nachrichten, Anrufe, Mitteilungen, Tickets, Projekte und E-Mail – mit Support-Zugriff auf Anfrage.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": { "languages": ["German", "English", "Arabic"], "displayLanguageSelector": true }
    },
    "android": {
      "minSdkVersion": 26
    }
  }
}
